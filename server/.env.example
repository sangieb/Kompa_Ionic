# Configuración del servidor de Kompa.
# Copia este archivo a `server/.env` y completa los valores sensibles.

NODE_ENV=development

# Port del servidor API
PORT=4000

# URL pública de la app (se usa para armar los enlaces de recuperación).
APP_URL=http://localhost:4200

# Origen permitido para CORS (la app de Ionic).
CORS_ORIGIN=http://localhost:4200

# Ruta de la base de datos SQLite.
DATABASE_PATH=./data/kompa.db

# Secretos de JWT (producción: valores largos y aleatorios).
JWT_SECRET=genera_un_secreto_largo_y_aleatorio_en_produccion
JWT_EXPIRACION_MS=900000

# Token de recuperación de contraseña: se guarda con hash y expira en 30 minutos.
RESET_TOKEN_TTL_MS=1800000

# SMTP del correo de recuperación.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp
SMTP_PASS=tu-clave-smtp
MAIL_FROM="Kompa <no-reply@tudominio.com>"
